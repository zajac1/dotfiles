#!/bin/bash
# omni top bar, modelled on omarchy's waybar.
#
# omarchy's actual layout (config/waybar/config.jsonc):
#   left   custom/omarchy, workspaces
#   centre clock, weather, update, indicators
#   right  tray, bluetooth, network, pulseaudio, cpu, battery
#
# and its style.css is FLAT - "border: none; border-radius: 0", every module on
# the bar background, separated by margin only. No pills. That is the main
# difference from where this started.
#
# Everything is event-driven (--subscribe); only the clock polls.

source "$HOME/.config/sketchybar/colors.sh"
PLUGINS="$HOME/.config/sketchybar/plugins"
FONT="JetBrainsMono Nerd Font"
[ -n "$(fc-list 2>/dev/null | grep -i 'JetBrainsMono Nerd')" ] || FONT="JetBrains Mono"

sketchybar --bar height=30 position=top sticky=on padding_left=10 padding_right=10 \
                 color=$BAR_COLOR shadow=off

# flat by default: no backgrounds, margin-only separation, like omarchy
sketchybar --default updates=when_shown \
                    icon.font="$FONT:Regular:13.0" icon.color=$LABEL \
                    label.font="$FONT:Regular:12.0" label.color=$LABEL \
                    icon.padding_left=7 icon.padding_right=4 \
                    label.padding_left=0 label.padding_right=7 \
                    background.drawing=off

# ---------------- left: omni launcher, spaces, focused app ----------------
sketchybar --add item logo left \
           --set logo icon=󰀵 icon.color=$ACCENT icon.font="$FONT:Bold:15.0" label.drawing=off \
                      click_script="$PLUGINS/toggle_omni.sh"

SPACES="${OMNI_BAR_SPACES:-5}"
for i in $(seq 1 "$SPACES"); do
  sketchybar --add item space.$i left \
             --set space.$i label="$i" icon.drawing=off \
                            label.font="$FONT:Bold:12.0" \
                            label.padding_left=6 label.padding_right=6 \
                            script="$PLUGINS/space.sh" \
                            click_script="$PLUGINS/goto_space.sh $i" \
             --subscribe space.$i space_change
done

sketchybar --add item front_app left \
           --set front_app icon.drawing=off label.color=$ACCENT \
                           label.font="$FONT:Bold:12.0" label.padding_left=8 \
                           script="$PLUGINS/front_app.sh" \
           --subscribe front_app front_app_switched

# ---------------- centre: clock and weather (omarchy puts them here) ------
sketchybar --add item clock center \
           --set clock icon.drawing=off label.font="$FONT:Bold:12.0" \
                       update_freq=10 script="$PLUGINS/clock.sh" \
                       click_script="open -a Calendar"

sketchybar --add item weather center \
           --set weather icon=󰖐 icon.color=$ACCENT update_freq=900 \
                         script="$PLUGINS/weather.sh" \
                         click_script="$PLUGINS/toggle_omni.sh"

# ---------------- right: icon-led status, like omarchy --------------------
sketchybar --add item battery right \
           --set battery script="$PLUGINS/battery.sh" update_freq=120 \
                         click_script="open 'x-apple.systempreferences:com.apple.Battery-Settings.extension'" \
           --subscribe battery power_source_change system_woke

sketchybar --add item cpu right \
           --set cpu icon=󰍛 update_freq=15 script="$PLUGINS/cpu.sh" \
                     click_script="open -na Ghostty.app --args -e $HOME/.local/bin/omni-btop 'cpu mem net proc'"

sketchybar --add item volume right \
           --set volume script="$PLUGINS/volume.sh" \
                        click_script="$PLUGINS/toggle_mute.sh" \
           --subscribe volume volume_change

sketchybar --add item wifi right \
           --set wifi script="$PLUGINS/wifi.sh" update_freq=60 \
                      click_script="open 'x-apple.systempreferences:com.apple.wifi-settings-extension'" \
           --subscribe wifi wifi_change

sketchybar --update
