#!/bin/bash
# omni top bar. Right side only for now: a single rounded container with
# coloured glyphs and neutral text (the calmer of the two reference bars).
#
# Colours come from ~/.config/sketchybar/colors.sh, generated by omni-bar-theme
# from the active omni palette - the bar re-themes with the launcher.
#
# Everything here is EVENT-DRIVEN (--subscribe) rather than polled where macOS
# emits an event. Polling shell scripts every second is the single biggest
# battery cost in a bar.

source "$HOME/.config/sketchybar/colors.sh"
PLUGINS="$HOME/.config/sketchybar/plugins"
FONT="JetBrains Mono"

sketchybar --bar height=32 position=top sticky=on padding_left=8 padding_right=8 \
                 color=0x00000000 shadow=off y_offset=4 margin=8 corner_radius=9

sketchybar --default updates=when_shown \
                    icon.font="$FONT:Bold:13.0" icon.color=$ACCENT icon.padding_left=8 icon.padding_right=4 \
                    label.font="$FONT:Medium:13.0" label.color=$LABEL label.padding_right=10 \
                    background.color=$ITEM_BG background.corner_radius=9 background.height=26 \
                    background.drawing=off

# --- right side: one container -------------------------------------------
sketchybar --add bracket status media volume battery clock \
           --set status background.color=$ITEM_BG background.corner_radius=9 \
                       background.height=26 background.drawing=on

sketchybar --add item clock right \
           --set clock icon=󰥔 update_freq=10 script="$PLUGINS/clock.sh" \
           --add item battery right \
           --set battery script="$PLUGINS/battery.sh" update_freq=120 \
           --subscribe battery power_source_change system_woke \
           --add item volume right \
           --set volume script="$PLUGINS/volume.sh" \
           --subscribe volume volume_change \
           --add item media right \
           --set media icon=󰝚 icon.color=$ACCENT label.max_chars=22 scroll_texts=on \
                       script="$PLUGINS/media.sh" \
           --subscribe media media_change

# --- left side ------------------------------------------------------------
SPACES="${OMNI_BAR_SPACES:-5}"
sketchybar --add item logo left \
           --set logo icon= icon.color=$ACCENT icon.font="$FONT:Bold:15.0" \
                      label.drawing=off click_script="open -a 'System Settings'"

for i in $(seq 1 "$SPACES"); do
  sketchybar --add item space.$i left \
             --set space.$i label="$i" icon.drawing=off \
                            label.font="$FONT:Bold:12.0" label.padding_left=8 label.padding_right=8 \
                            background.corner_radius=7 background.height=20 \
                            script="$PLUGINS/space.sh" \
                            click_script="osascript -e 'tell application \"System Events\" to key code $((17+i)) using control down'" \
             --subscribe space.$i space_change
done

sketchybar --add item front_app left \
           --set front_app icon.drawing=off label.font="$FONT:Bold:13.0" label.color=$ACCENT \
                           background.color=$ITEM_BG background.drawing=on \
                           script="$PLUGINS/front_app.sh" \
           --subscribe front_app front_app_switched

sketchybar --update
