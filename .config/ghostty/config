# Theme is managed by tinty (see ~/.config/tinted-theming/).
# Run `tinty apply <scheme>` to switch; restart Ghostty to apply.
theme = /Users/adamzajac/dotfiles/.config/ghostty/themes/tinted

# omni writes its palette to omni-theme on every `omni-theme <name>` switch
# (and the tinty hook drives that too, so the two agree). config-file contents
# are applied AFTER the file that declares them, so this wins over the tinty
# theme above wherever both exist. `?` = no error on a machine without omni.
# Generated per machine, so it is gitignored.
config-file = ?omni-theme
font-family = GohuFont 14 Nerd Font
font-size = 20
background-opacity = 0.75
background-blur = true
maximize = true
window-save-state = "always"
window-colorspace = "display-p3"

# Drop-down quick terminal from any app (VS Code-style ctrl+`)
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# Split menu (tmux-style): cmd+d, then % = split right, " = split down,
# arrows = move focus, f = fullscreen toggle, x = close, = = equal sizes.
keybind = cmd+d>shift+digit5=new_split:right
keybind = cmd+d>shift+quote=new_split:down
keybind = cmd+d>arrow_right=goto_split:right
keybind = cmd+d>arrow_down=goto_split:down
keybind = cmd+d>arrow_left=goto_split:left
keybind = cmd+d>arrow_up=goto_split:up
keybind = cmd+d>f=toggle_split_zoom
keybind = cmd+d>x=close_surface
keybind = cmd+d>equal=equalize_splits

# Shaders (tracked in shaders/): theme-colored cursor smear, theme-derived
# gradient background (accent pair rotated by shaders/rotate-gradient.sh,
# hooked in ~/.zshrc), unfocused-pane dimmer. Apply edits via cmd+shift+,
# The untracked ghostty-shaders/ clone is a playground for experiments.
custom-shader = shaders/cursor_warp.glsl
custom-shader = shaders/gradient-static-theme.glsl
custom-shader = shaders/bespoke-focus-dim.glsl
