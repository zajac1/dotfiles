# HEY mail: a full window with no title bar, nothing but the client.
# Launched by omni-mail-hey with --config-default-files=false, so this is the
# whole configuration - it deliberately inherits none of the main terminal's
# splits, shaders or transparency.
command = /Users/adamzajac/.local/bin/hey tui --instance mail

# TRAP: quit-after-last-window-closed defaults to FALSE on macOS. The launcher
# and calendar want that - they are quick terminals that must survive being
# dismissed - but a normal window must not: quitting HEY would close the window
# and leave a windowless Ghostty in the Dock and in cmd-tab forever. Likewise
# no initial-command here; that is the quick-terminal trick for keeping the
# first surface empty, and it has no place in a window meant to show the app.
quit-after-last-window-closed = true

# no title bar, no shadow: the client fills the window
window-decoration = false
macos-titlebar-style = hidden
maximize = true
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true

# the active omni palette, so it matches the launcher and the terminal
config-file = ?omni-theme

shell-integration = none
confirm-close-surface = false
resize-overlay = never
mouse-hide-while-typing = true
