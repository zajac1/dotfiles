#!/bin/bash
set -u

FAVS="$HOME/.config/omni/favorites"
touch "$FAVS"

line="${1-}"
[ -n "$line" ] || exit 0

kind=$(printf '%s' "$line" | cut -f1)
path=$(printf '%s' "$line" | cut -f3)

[ "$kind" = "app" ] || exit 0
[ -n "$path" ] || exit 0

if grep -qxF "$path" "$FAVS"; then
  # grep -v exits 1 when it prints nothing (i.e. removing the last entry),
  # so it must NOT gate the mv. This silently broke unpinning the last app.
  grep -vxF "$path" "$FAVS" > "$FAVS.tmp" || true
  mv "$FAVS.tmp" "$FAVS"
else
  printf '%s\n' "$path" >> "$FAVS"
fi
