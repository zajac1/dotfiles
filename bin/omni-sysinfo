#!/bin/bash
#
# omni-sysinfo - live CPU / memory / network rows for the Utilities submenus.
#
# btop itself cannot be piped into the menu: it is a full-screen TUI with no
# one-shot mode, and fzf renders a list of text rows. So the submenus show a
# cheap snapshot and offer btop for the real thing.
#
# COST MATTERS - these run on every menu render:
#   top -l 1 -n 0   947 ms   <- far too slow, avoided
#   ps -A -o %cpu   573 ms   <- ditto
#   vm_stat          27 ms
#   sysctl           24 ms
#   netstat -ib      54 ms
# Hence load average rather than instantaneous CPU%, and vm_stat rather than top.

set -u
. "$HOME/.config/omni/config.sh" 2>/dev/null || true
row() { printf 'sep\t%s  %s\t\n' "$1" "$2"; }

case "${1-}" in
cpu)
  cores=$(sysctl -n hw.ncpu)
  set -- $(sysctl -n vm.loadavg | tr -d '{}')
  pct=$(awk -v l="$1" -v c="$cores" 'BEGIN{printf "%.0f", (l/c)*100}')
  row "" "load $1  ·  ${pct}% of $cores cores"
  row "" "5 min $2  ·  15 min $3"
  row "" "$(ps -A -o comm= | wc -l | tr -d ' ') processes"
  ;;
mem)
  total=$(sysctl -n hw.memsize)
  eval "$(vm_stat | awk -F: '
    /page size of/ { gsub(/[^0-9]/,"",$0); print "ps=" $0 }
    /Pages active/ { gsub(/[^0-9]/,"",$2); print "act=" $2 }
    /Pages wired/  { gsub(/[^0-9]/,"",$2); print "wir=" $2 }
    /Pages occupied by compressor/ { gsub(/[^0-9]/,"",$2); print "cmp=" $2 }
    /Pages free/   { gsub(/[^0-9]/,"",$2); print "fre=" $2 }')"
  used=$(( (act + wir + cmp) * ps ))
  row "" "$(awk -v u="$used" -v t="$total" 'BEGIN{printf "%.1f", u/1073741824}') GB of $(awk -v t="$total" 'BEGIN{printf "%.0f", t/1073741824}') GB used"
  row "" "$(awk -v u="$used" -v t="$total" 'BEGIN{printf "%.0f", (u/t)*100}')% · free $(awk -v f="$fre" -v p="$ps" 'BEGIN{printf "%.1f", (f*p)/1073741824}') GB"
  # top three by RSS - the point of this view is spotting what is making the
  # machine feel slow. /bin/ps because ps is often aliased; 87ms, versus 573ms
  # for ps -A -o %cpu and 947ms for top.
  /bin/ps -A -o rss=,comm= | sort -rn | head -3 | while read -r kb cmd; do
    row "" "$(awk -v k="$kb" 'BEGIN{printf "%.1f GB", k/1048576}')  $(basename "$cmd")"
  done
  ;;
net)
  PREV="$HOME/.cache/omni/net.prev"
  now=$(date +%s)
  read -r rx tx <<EOF
$(netstat -ib | awk '$1 !~ /^lo/ && $3 ~ /^</ { r += $7; t += $10 } END { print r+0, t+0 }')
EOF
  if [ -s "$PREV" ]; then
    read -r pt prx ptx < "$PREV"
    dt=$(( now - pt ))
    if [ "$dt" -gt 0 ] && [ "$rx" -ge "$prx" ]; then
      row "" "down $(awk -v b="$((rx-prx))" -v d="$dt" 'BEGIN{printf "%.1f", b/d/1048576}') MB/s"
      row "" "up   $(awk -v b="$((tx-ptx))" -v d="$dt" 'BEGIN{printf "%.1f", b/d/1048576}') MB/s"
      row "" "over the last ${dt}s"
    else
      row "" "sampling…"
    fi
  else
    row "" "sampling… reopen for rates"
  fi
  printf '%s %s %s\n' "$now" "$rx" "$tx" > "$PREV"
  row "" "total $(awk -v r="$rx" 'BEGIN{printf "%.1f", r/1073741824}') GB in · $(awk -v t="$tx" 'BEGIN{printf "%.1f", t/1073741824}') GB out"
  ;;
esac
