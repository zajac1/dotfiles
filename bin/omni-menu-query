#!/bin/bash
set -u

. "$HOME/.config/omni/config.sh"
. "$HOME/.local/bin/omni-lib"

INDEX="$HOME/.cache/omni/index.tsv"
FAVS="$HOME/.config/omni/favorites"
touch "$FAVS" 2>/dev/null
TAB=$(printf '\t')
level="${1-}"
q="${2-}"

# Favourites can now hold ANY menu row, not just apps. The file stores
# "kind<TAB>payload" per line; a line with no tab is a legacy bare app path.
# The display text is resolved at render time so it follows theme and glyph
# changes instead of going stale.
FAV_LEVELS="style theme setup capture update system utilities"
BOXTOP=$(printf "\xe2\x95\xad"); BOXBOT=$(printf "\xe2\x95\xb0")
BOXTR=$(printf "\xe2\x95\xae");  BOXBR=$(printf "\xe2\x95\xaf")
VERT=$(printf "\xe2\x94\x82");   HR=$(printf "\xe2\x94\x80")

fav_lines() { grep -vE '^[[:space:]]*(#|$)' "$FAVS" 2>/dev/null; }

resolve_fav() {
  case "$1" in
    app|project) grep -F "$TAB$2" "$INDEX" 2>/dev/null | head -1 ;;
    *) for lvl in $FAV_LEVELS; do rows "$lvl"; done |
         awk -F'\t' -v k="$1" -v p="$2" '$1==k && $3==p {print; exit}' ;;
  esac
}

emit_favorites() {
  [ "${NO_FAVS:-0}" = 1 ] && return 0
  [ -s "$FAVS" ] || return 0
  w=${OMNI_ROW_WIDTH:-23}
  # top rule: "╭─ Favorites ───────╮" padded to exactly w cells
  lbl=" Favorites "
  n=$(( w - 3 - ${#lbl} ))
  [ "$n" -lt 0 ] && n=0
  rule=""; i=0; while [ "$i" -lt "$n" ]; do rule="$rule$HR"; i=$((i+1)); done
  printf 'sep\t\033[38;5;20m%s%s%s%s%s\033[0m\t\n' "$BOXTOP" "$HR" "$lbl" "$rule" "$BOXTR"
  fav_lines | head -5 | while IFS= read -r line; do
    case "$line" in
      *"$TAB"*) k=${line%%	*}; v=${line#*	} ;;
      *)        k=app; v=$line ;;
    esac
    [ -n "$v" ] || continue
    # pad to a fixed inner width so the right edge lines up. Width is measured
    # in CELLS: strip ANSI, then subtract 2 per Nerd Font glyph (3 bytes, 1 cell).
    resolve_fav "$k" "$v" | awk -F'\t' -v OFS='\t' -v v="$VERT" -v w="$w" '{
      plain = $2; gsub(/\033\[[0-9;]*m/, "", plain)
      # macOS awk length() counts BYTES. Every row carries exactly one leading
      # Nerd Font glyph: 3 bytes, 1 cell. So cells = bytes - 2.
      cells = length(plain) - 2
      pad = w - 3 - cells
      if (pad < 0) pad = 0
      $2 = v " " $2 sprintf("%*s", pad, "") v
      print
    }'
  done
  n=$(( w - 2 )); [ "$n" -lt 0 ] && n=0
  rule=""; i=0; while [ "$i" -lt "$n" ]; do rule="$rule$HR"; i=$((i+1)); done
  printf 'sep\t\033[38;5;20m%s%s%s\033[0m\t\n' "$BOXBOT" "$rule" "$BOXBR"
  printf 'sep\t\t\n'
}

# A row that is already pinned gets a trailing star in its home section - the
# only visual confirmation that ctrl-p worked. Appended, never right-aligned:
# right-alignment needs padding, and padding is what kept truncating/wrapping.
mark_favs() {
  awk -F'\t' -v OFS='\t' -v star=" " '
    NR==FNR {
      if ($0 ~ /\t/) { split($0, a, "\t"); fav[a[1] SUBSEP a[2]]=1 }
      else if (length($0)) fav["app" SUBSEP $0]=1
      next
    }
    { if (NF>=3 && (($1 SUBSEP $3) in fav)) $2 = $2 star; print }
  ' "$FAVS" -
}

SECTIONS="$HOME/.config/omni/sections"
if [ -s "$SECTIONS" ]; then
  ids=$(grep -vE '^[[:space:]]*(#|$)' "$SECTIONS" | tr -d ' ')
else
  ids="apps style setup capture utilities update system"
fi

rows() {
lvl="${1-$level}"
case "$lvl" in
  "")
    emit_favorites
    # Root entries are listed in ~/.config/omni/sections, one id per line.
    # Comment a line out to hide that section; reorder lines to reorder the menu.
    for id in $ids; do
      case "$id" in
        apps)    printf 'search\t%s  Apps\t\n'      "" ;;
        style)   printf 'menu\t%s  Style\tstyle\n'  "" ;;
        setup)   printf 'menu\t%s  Setup\tsetup\n'  "" ;;
        capture) printf 'menu\t%s  Capture\tcapture\n' "" ;;
        update)  printf 'menu\t%s  Update\tupdate\n' "" ;;
        utilities) printf 'menu\t%s  Utilities\tutilities\n' "" ;;
        system)  printf 'menu\t%s  System\tsystem\n' "" ;;
      esac
    done
    ;;
  style)
    printf 'menu\t%s  Theme\ttheme\n' "$(printf '\xef\x87\x9e')"
    printf 'menu\t%s  Font\tfont\n'  "$(printf '\xef\x80\xb1')"
    ;;
  font)
    # Ghostty has no escape sequence for changing font, so unlike themes this
    # cannot preview live - Enter writes the config and restarts the instance.
    FONTS="$HOME/.cache/omni/fonts.txt"
    if [ ! -s "$FONTS" ] || [ -n "$(find "$FONTS" -mtime +7 2>/dev/null)" ]; then
      /Applications/Ghostty.app/Contents/MacOS/ghostty +list-fonts 2>/dev/null |
        grep -E '^[A-Za-z]' | grep -iE 'mono|nerd|code|consol|menlo|courier' |
        sort -u > "$FONTS"
    fi
    while IFS= read -r fam; do
      [ -n "$fam" ] || continue
      if [ "$fam" = "$OMNI_FONT" ]; then
        printf 'font\t%s  %s\t%s\n' "$(printf '\xef\x80\x8c')" "$fam" "$fam"
      else
        printf 'font\t   %s\t%s\n' "$fam" "$fam"
      fi
    done < "$FONTS"
    ;;
  theme)
    current=$(sed -n 's/^OMNI_THEME="\(.*\)"/\1/p' "$HOME/.config/omni/config.sh")
    for f in "$HOME"/.config/omni/themes/*.sh; do
      name="${f##*/}"; name="${name%.sh}"
      if [ "$name" = "$current" ]; then
        printf 'theme\t  %s\t%s\n' "$name" "$name"
      else
        printf 'theme\t   %s\t%s\n' "$name" "$name"
      fi
    done
    ;;
  setup)
    printf 'run\t  Wifi\twifi\n'
    printf 'run\t  Bluetooth\tbluetooth\n'
    printf 'run\t  Audio\taudio\n'
    printf 'run\t  Displays\tdisplays\n'
    printf 'run\t  Config\tconfig\n'
    ;;
  update)
    printf 'run\t  Homebrew\tbrew\n'
    printf 'run\t  macOS\tmacos\n'
    ;;
  update)
    printf 'run\t  Homebrew\tbrew\n'
    printf 'run\t  macOS\tmacos\n'
    ;;
  utilities)
    printf 'menu\t  Weather\tweather\n'
    printf 'menu\t  CPU\tcpu\n'
    printf 'menu\t  Memory\tmemory\n'
    printf 'menu\t  Network\tnetwork\n'
    printf 'run\t  System Monitor\tmonitor\n'
    printf 'run\t  Caffeinate\tcaffeinate\n'
    ;;
  weather)
    omni-weather
    ;;
  cpu|mem*|net*)
    case "$lvl" in cpu) k=cpu ;; mem*) k=mem ;; *) k=net ;; esac
    omni-sysinfo "$k"
    printf 'run\t  Open in btop\tbtop-%s\n' "$k"
    printf 'act\t  Refresh\t%s-refresh\n' "$k"
    printf 'back\t  Back\t\n'
    ;;
  capture)
    printf 'run\t  Screenshot\tscreenshot\n'
    printf 'run\t  Color Picker\tcolorpicker\n'
    ;;
  system)
    printf 'run\t  Lock\tlock\n'
    printf 'run\t  Screensaver\tsaver\n'
    printf 'run\t  Sleep\tsleep\n'
    printf 'menu\t  Logout\tconfirm:logout\n'
    printf 'menu\t  Restart\tconfirm:restart\n'
    printf 'menu\t  Shutdown\tconfirm:shutdown\n'
    ;;
  confirm:*)
    what="${level#confirm:}"
    printf 'run\t  Yes, %s\t%s\n' "$what" "$what"
    printf 'back\t  Cancel\t\n'
    ;;
esac
}

if [ -z "$q" ]; then
  if [ -z "$level" ]; then rows; else rows | mark_favs; fi
  exit 0
fi

# The menu prompt doubles as a calculator and a web search, so a query can
# produce rows that are not in the menu tree at all. That is why omni runs the
# menu with --disabled and filters here instead of letting fzf do it.
case "$q" in
  '='*) emit_calc "${q#=}"; exit 0 ;;
  '@'*) emit_web  "${q#@}"; exit 0 ;;
esac

looks_like_math "$q" && emit_calc "$q"

if [ -z "$level" ]; then
  # 2. favourites are already reachable via their own sections; emitting the
  #    boxed copies here produced duplicate hits for every pinned item.
  NO_FAVS=1
  # Flatten only the sections that are actually enabled, so hiding one in
  # ~/.config/omni/sections also removes it from search. `font` is left out on
  # purpose: half the family names contain "Mono"/"Nerd" and match everything.
  rows ""
  for id in $ids; do
    case "$id" in
      style)   rows style; rows theme ;;
      setup)   rows setup ;;
      capture) rows capture ;;
      update)  rows update ;;
      utilities) rows utilities ;;
      system)  rows system ;;
    esac
  done
else
  rows "$level"
fi | { if [ -z "$level" ]; then grep -v "^sep$TAB"; else cat; fi; } |
  awk -F'\t' -v OFS='\t' '!seen[$2]++' |
  mark_favs | fzf --ansi --filter="$q" --delimiter="$TAB" --nth=2 2>/dev/null

emit_web "$q"
