#!/bin/bash
#
# omni - dispatcher. Two modes in one script:
#   menu   (default)  : rows piped in, fzf does the filtering
#   search (--search) : fzf --disabled, omni-query re-run on every keystroke
#
# ---------------------------------------------------------------------------
# TRAPS - read before changing anything dimensional. Each of these cost hours.
# ---------------------------------------------------------------------------
#
# 1. Ghostty's quick terminal IGNORES window-width / window-height (checked on
#    1.3.1: the only quick-terminal-* options are position, screen,
#    animation-duration, autohide, space-behavior, keyboard-interactivity).
#    It is always 80x24. That is why OMNI_FRAME="boxed" exists: Ghostty runs at
#    background-opacity=0 so the window is invisible, and fzf --margin draws a
#    correctly sized box inside it. Everything you see is painted by fzf.
#
# 2. Because the window is transparent, ANY cell fzf does not explicitly paint
#    shows the desktop through it. Every background slot must be set - bg,
#    current-bg, input-bg, list-bg, header-bg, selected-bg, preview-bg, gutter.
#    Symptom of missing one: a YouTube video visible through the selected row.
#
# 3. OMNI_CHROME=13 is MEASURED IN THE REAL GHOSTTY, not derived. A pty test
#    harness (pty.fork + pyte) under-reports fzf's chrome by ~6 rows, so it will
#    tell you 7 and the menu will render 3 items on the real screen. Trust
#    screenshots for anything dimensional; trust the harness only for structure
#    (which rows exist, whether navigation skips a spacer, is a glyph present).
#
# 4. RUNEWIDTH_EASTASIAN=0 is load-bearing. Nerd Font glyphs live in the
#    Private Use Area, which Unicode classifies as Ambiguous width. Without
#    this, fzf counts every icon as 2 cells, believes rows overflow, and
#    truncates them. Reproduce the bug by setting it to 1.
#
# 5. --ellipsis='' is deliberate. fzf and Ghostty disagree about usable width by
#    a few cells and no amount of padding arithmetic settled it. Rather than fix
#    the disagreement, we make truncation invisible. Do not restore an ellipsis
#    without solving 3 first.
#
# 6. --header-lines=1 is applied ONLY when the first row is a `sep`. It makes
#    the "Favorites" title non-selectable. Applying it unconditionally would
#    swallow the first real menu entry.
#
# 7. down/up are rebound so arrow keys step OVER `sep` rows (omni-skip). fzf has
#    no concept of a disabled row; a blank spacer is otherwise selectable and
#    the selection appears to vanish. Direction must be passed through, or
#    arrowing up traps you against the spacer.
#
# 8. The cursor is hidden (ESC[?25l) before the clear. Otherwise it sits at the
#    grid origin - 11 columns left of the visible box, over transparent
#    background - for ~80ms until fzf paints. ~16ms of that is fzf's own init
#    and cannot be suppressed.
#
set -u

export RUNEWIDTH_EASTASIAN=0

printf '\033[?25l\033[2J\033[3J\033[H' 2>/dev/null

. "$HOME/.config/omni/config.sh"

CACHE="$HOME/.cache/omni"
STACK="$CACHE/stack"
MODE="$CACHE/mode"
TAB=$'\t'
[ -d "$CACHE" ] || mkdir -p "$CACHE"

case "${1-}" in
  --search) mode=search ;;
  --menu)   mode=menu ;;
  *)        mode=menu; : > "$STACK"
            ( omni-index >/dev/null 2>&1 & ) ;;
esac

printf '%s' "$mode" > "$MODE"
: > "$CACHE/pending"

if [ "$mode" = search ]; then
  want_cols=$OMNI_COLS
  want_rows=$OMNI_ROWS
  ghost=' Search...'
  gap="--gap=1"
  gapline="--gap-line="
else
  level=$(tail -1 "$STACK" 2>/dev/null)
  level="${level:-}"
  export OMNI_ROW_WIDTH=$(( OMNI_MENU_COLS - OMNI_FILL_INSET ))
  ITEMS=$(omni-menu-query "$level")
  n=0
  if [ -n "$ITEMS" ]; then
    while IFS= read -r _; do n=$((n+1)); done <<EOF
$ITEMS
EOF
  fi
  want_cols=$OMNI_MENU_COLS
  want_rows=$(( n + OMNI_CHROME ))
  [ "$want_rows" -gt "$OMNI_MENU_MAX_ROWS" ] && want_rows=$OMNI_MENU_MAX_ROWS
  case "$level" in
    "")        label="Go" ;;
    confirm:*) label="Confirm" ;;
    *)         label="$(printf '%s' "$level" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')" ;;
  esac
  ghost="${label}…"
  gap=""
  gapline=""
  hdr=0
  case "$ITEMS" in sep"$TAB"*) hdr=1 ;; esac
  want_rows=$(( n + OMNI_CHROME ))
  [ "$want_rows" -gt "$OMNI_MENU_MAX_ROWS" ] && want_rows=$OMNI_MENU_MAX_ROWS
fi

omni-osc 2>/dev/null


margin=0
bg="-1"
if [ "$OMNI_FRAME" = "boxed" ]; then
  cols=$(tput cols 2>/dev/null || echo "$want_cols")
  rows=$(tput lines 2>/dev/null || echo "$want_rows")
  side=$(( (cols - want_cols) / 2 )); [ "$side" -lt 0 ] && side=0
  top=$(( (rows - want_rows) / 2 ));  [ "$top"  -lt 0 ] && top=0
  margin="$top,$side"
  bg="16"
fi

set -- \
  --style=minimal \
  --ansi \
  --layout=reverse \
  --cycle \
  --border="$OMNI_BORDER_STYLE" \
  --input-border="$OMNI_BORDER_STYLE" \
  --padding=1,1 \
  --margin="$margin" \
  --prompt='' \
  --ghost="$ghost" \
  --pointer='' \
  --marker='' \
  --info=hidden \
  --no-scrollbar \
  --highlight-line \
  ${gap:+$gap} ${gapline:+$gapline} \
  --ellipsis='' \
  --delimiter="$TAB" \
  --with-nth=2 \
  --bind 'esc:transform(omni-back {q})' \
  --bind 'down:down+transform(omni-skip {} down)' \
  --bind 'up:up+transform(omni-skip {} up)' \
  --bind 'ctrl-j:down+transform(omni-skip {} down)' \
  --bind 'ctrl-k:up+transform(omni-skip {} up)' \
  --bind 'enter:transform(omni-enter {})' \
  --color="bg:${bg},fg:17,current-bg:23,current-fg:19:regular,hl:17,hl+:19,border:18,input-border:18,input-bg:${bg},list-bg:${bg},header-bg:${bg},selected-bg:${bg},preview-bg:${bg},query:17,ghost:20,gutter:${bg}"

if [ "$mode" = search ]; then
  fzf --disabled \
      --bind "start:reload(omni-query '')" \
      --bind "change:reload(omni-query {q})" \
      --bind "ctrl-p:execute-silent(omni-toggle-pin {})+reload(omni-query {q})" \
      "$@"
else
  at=""
  extra=()
  case "$ITEMS" in sep"$TAB"*) extra+=("--header-lines=1") ;; esac
  if [ "$level" = theme ]; then
    if [ -z "$at" ]; then
      at=$(omni-menu-query theme | awk -F'\t' -v c="$OMNI_THEME" '$3==c{print NR-1; exit}')
    fi
    extra+=("--bind=focus:execute-silent(omni-osc {3})")
  fi
  case "$at" in ""|*[!0-9]*) : ;; *) extra+=("--bind=start:pos($((at+1)))") ;; esac
  printf '%s\n' "$ITEMS" | \
    fzf --bind 'ctrl-p:execute-silent(omni-toggle-pin {})+become(omni --menu)' \
        ${extra[@]+"${extra[@]}"} "$@"
fi
