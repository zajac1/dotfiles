#!/bin/bash
set -u

export RUNEWIDTH_EASTASIAN=0

printf '\033[?25l\033[2J\033[3J\033[H' 2>/dev/null

. "$HOME/.config/omni/config.sh"

CACHE="$HOME/.cache/omni"
STACK="$CACHE/stack"
MODE="$CACHE/mode"
TAB=$'\t'
[ -d "$CACHE" ] || mkdir -p "$CACHE"

case "${1-}" in
  --search) mode=search ;;
  --menu)   mode=menu ;;
  *)        mode=menu; : > "$STACK"
            ( omni-index >/dev/null 2>&1 & ) ;;
esac

printf '%s' "$mode" > "$MODE"
: > "$CACHE/pending"

if [ "$mode" = search ]; then
  want_cols=$OMNI_COLS
  want_rows=$OMNI_ROWS
  ghost=' Search...'
  gap=""
  gapline=""
else
  level=$(tail -1 "$STACK" 2>/dev/null)
  level="${level:-}"
  export OMNI_ROW_WIDTH=$(( OMNI_MENU_COLS - OMNI_FILL_INSET ))
  ITEMS=$(omni-menu-query "$level")
  n=0
  if [ -n "$ITEMS" ]; then
    while IFS= read -r _; do n=$((n+1)); done <<EOF
$ITEMS
EOF
  fi
  want_cols=$OMNI_MENU_COLS
  want_rows=$(( n + OMNI_CHROME ))
  [ "$want_rows" -gt "$OMNI_MENU_MAX_ROWS" ] && want_rows=$OMNI_MENU_MAX_ROWS
  case "$level" in
    "")        label="Go" ;;
    confirm:*) label="Confirm" ;;
    *)         label="$(printf '%s' "$level" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')" ;;
  esac
  ghost="${label}…"
  gap=""
  gapline=""
  hdr=0
  case "$ITEMS" in sep"$TAB"*) hdr=1 ;; esac
  want_rows=$(( n + OMNI_CHROME ))
  [ "$want_rows" -gt "$OMNI_MENU_MAX_ROWS" ] && want_rows=$OMNI_MENU_MAX_ROWS
fi

omni-osc 2>/dev/null


margin=0
bg="-1"
if [ "$OMNI_FRAME" = "boxed" ]; then
  cols=$(tput cols 2>/dev/null || echo "$want_cols")
  rows=$(tput lines 2>/dev/null || echo "$want_rows")
  side=$(( (cols - want_cols) / 2 )); [ "$side" -lt 0 ] && side=0
  top=$(( (rows - want_rows) / 2 ));  [ "$top"  -lt 0 ] && top=0
  margin="$top,$side"
  bg="16"
fi

set -- \
  --style=minimal \
  --ansi \
  --layout=reverse \
  --cycle \
  --border="$OMNI_BORDER_STYLE" \
  --input-border="$OMNI_BORDER_STYLE" \
  --padding=1,1 \
  --margin="$margin" \
  --prompt='' \
  --ghost="$ghost" \
  --pointer='' \
  --marker='' \
  --info=hidden \
  --no-scrollbar \
  --highlight-line \
  ${gap:+$gap} ${gapline:+$gapline} \
  --ellipsis='' \
  --delimiter="$TAB" \
  --with-nth=2 \
  --bind 'esc:transform(omni-back {q})' \
  --bind 'down:down+transform(omni-skip {} down)' \
  --bind 'up:up+transform(omni-skip {} up)' \
  --bind 'ctrl-j:down+transform(omni-skip {} down)' \
  --bind 'ctrl-k:up+transform(omni-skip {} up)' \
  --bind 'enter:transform(omni-enter {})' \
  --color="bg:${bg},fg:17,current-bg:23,current-fg:19:regular,hl:17,hl+:19,border:18,input-border:18,input-bg:${bg},list-bg:${bg},header-bg:${bg},selected-bg:${bg},preview-bg:${bg},query:17,ghost:20,gutter:${bg}"

if [ "$mode" = search ]; then
  fzf --disabled \
      --bind "start:reload(omni-query '')" \
      --bind "change:reload(omni-query {q})" \
      --bind "ctrl-p:execute-silent(omni-toggle-pin {})+reload(omni-query {q})" \
      "$@"
else
  at=""
  extra=()
  startacts="transform(omni-skip {} down)"
  if [ "$level" = theme ]; then
    if [ -z "$at" ]; then
      at=$(omni-menu-query theme | awk -F'\t' -v c="$OMNI_THEME" '$3==c{print NR-1; exit}')
    fi
    extra+=("--bind=focus:execute-silent(omni-osc {3})")
  fi
  case "$at" in ""|*[!0-9]*) : ;; *) startacts="pos($((at+1)))+$startacts" ;; esac
  extra+=("--bind=start:$startacts")
  extra+=("--bind=change:reload(omni-menu-query '$level' {q})")
  printf '%s\n' "$ITEMS" | \
    fzf --disabled \
        --bind 'ctrl-p:execute-silent(omni-toggle-pin {})+become(omni --menu)' \
        ${extra[@]+"${extra[@]}"} "$@"
fi
