#!/bin/bash
#
# omni-weather-report - the expanded Weather view, opened in its own window.
#
# Layout: wttr.in's ASCII art for the current condition, then temperature with
# a clothing cue, the per-slot rain forecast, and wind.
#
# TRAPS:
#  - wttr.in serves HTML unless the UA looks like a terminal client (-A curl/8).
#  - the art must have ANSI stripped BEFORE `cut`, or cut counts escape bytes as
#    columns and slices the picture apart. It is re-coloured from the theme.
#  - LC_ALL must be a UTF-8 locale or `cut -c` counts bytes.

set -u
export LC_ALL=en_US.UTF-8
. "$HOME/.config/omni/config.sh" 2>/dev/null || true
. "$HOME/.config/omni/themes/${OMNI_THEME:-tokyo-night}.sh" 2>/dev/null || true

loc="${OMNI_WEATHER_LOCATION:-}"
CACHE="$HOME/.cache/omni/weather.json"
ACCENT="${OMNI_ACCENT:-#7aa2f7}"
DIM="${OMNI_DIM:-#565f89}"

rgb() { printf '\033[38;2;%d;%d;%dm' "$((16#${1:1:2}))" "$((16#${1:3:2}))" "$((16#${1:5:2}))"; }
A=$(rgb "$ACCENT"); D=$(rgb "$DIM"); R=$(printf '\033[0m')

[ -s "$CACHE" ] || curl -sS --max-time 12 -A "curl/8" "https://wttr.in/${loc}?format=j1" -o "$CACHE" 2>/dev/null

art=$(curl -sS --max-time 12 -A "curl/8" "https://wttr.in/${loc}?0" 2>/dev/null \
      | sed 's/\x1b\[[0-9;]*m//g' | tail -n +3 | cut -c1-15)

echo
[ -n "$art" ] && printf '%s\n' "$art" | while IFS= read -r l; do printf '   %s%s%s\n' "$A" "$l" "$R"; done
echo

if [ -s "$CACHE" ]; then
  jq -r --arg hh "$(date +%H)" --arg a "$A" --arg d "$D" --arg r "$R" '
    .current_condition[0] as $c
    | .nearest_area[0] as $n
    | ($c.FeelsLikeC|tonumber) as $f
    | ( if   $f <  2 then ["󰜗", "heavy coat"]
        elif $f < 14 then ["󰬡", "coat"]
        elif $f < 22 then ["󰬢", "t-shirt"]
        else              ["󰏕", "shade and water"] end ) as $wear
    | [ .weather[0].hourly[] | select((.time|tonumber/100|floor) >= ($hh|tonumber)) ] as $rest
    | "   \($a)\($wear[0])\($r)  \($c.temp_C)°C · feels \($c.FeelsLikeC)°C  \($d)· \($wear[1])\($r)",
      "   \($a)󰝐\($r)  " +
        ( if ($rest|length) == 0 then "no more slots today"
          else ($rest | map("\((.time|tonumber/100|floor|tostring))h \(.chanceofrain)%") | join("  ")) end ),
      "   \($a)󰖝\($r)  \($c.windspeedKmph) km/h \($c.winddir16Point)" +
        ( [ $rest[] | select((.WindGustKmph|tonumber) >= 40) ]
          | if length > 0 then " · gusts \(map(.WindGustKmph|tonumber)|max)" else "" end ),
      "",
      "   \($d)\($n.areaName[0].value), \($n.country[0].value) · observed \($c.observation_time)\($r)"
  ' "$CACHE"
else
  printf '   weather unavailable\n'
fi

echo
printf '   %sPress enter to close%s ' "$D" "$R"
read -r
