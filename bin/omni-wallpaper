#!/bin/bash
# Spike: set the desktop wallpaper from omni.
#
# NSWorkspace sets the picture for the CURRENT Space only; every other Space
# keeps its own override in Apple's wallpaper store and there is no public API
# for those. Measured on macOS 26:
#   - WallpaperAgent only rereads the store when restarted;
#   - on restart it first redraws whatever it last showed, not the store;
#   - a set made after it is up sticks.
# So: write the new entry into every Space's override in the store, restart
# the agent (it redraws the old picture, which is already on screen - nothing
# visible happens), then set once. One visible transition, old to new. The
# earlier set-first orders showed the new picture, then the old, then the new.
# Idle (screensaver) entries are left alone. The store is backed up first.
set -u

. "$HOME/.config/omni/config.sh"

# Per-theme override: themes/<name>/wallpaper.toml with
#   placement = "fill" | "fit" | "center" | "stretch"
#   fill = "#rrggbb"          colour around the image for fit/center
# Defaults: OMNI_WALLPAPER_PLACEMENT from config.sh (fill), fill = OMNI_BASE.
WP_TOML="$HOME/.config/omni/themes/$OMNI_THEME/wallpaper.toml"
tval() { sed -n "s/^$1[[:space:]]*=[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$WP_TOML" 2>/dev/null | head -1; }
PLACEMENT=$(tval placement); PLACEMENT="${PLACEMENT:-${OMNI_WALLPAPER_PLACEMENT:-fill}}"
FILL=$(tval fill); FILL="${FILL:-$OMNI_BASE}"
case "$FILL" in '#'[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;; *) FILL="#000000" ;; esac
# NSWorkspace scaling / clipping, and the id the store uses - measured, see
# GOTCHAS: fill=Crop, fit=SizeToFit, center=Centered, stretch=FillScreen.
# "gradient" is not a macOS placement: the picture is rendered onto a screen-
# sized canvas whose surround is a gradient fitted from its own corners
# (omni-wallpaper-render), and THAT file is set as a plain fill. scale is the
# picture's height as a fraction of the screen's.
SCALE=$(tval scale); SCALE="${SCALE:-0.9}"
case "$PLACEMENT" in
  fit)     SCALING=3; CLIP=0; PLACE_ID=SizeToFit ;;
  center)  SCALING=2; CLIP=0; PLACE_ID=Centered ;;
  stretch) SCALING=1; CLIP=0; PLACE_ID=FillScreen ;;
  gradient) SCALING=3; CLIP=1; PLACE_ID=Crop ;;
  *)       SCALING=3; CLIP=1; PLACE_ID=Crop; PLACEMENT=fill ;;
esac

# For gradient, swap the picture for its rendered canvas (cached by source
# mtime under ~/.cache/omni/wallpapers). Every other placement uses the file.
render_if_needed() { # path -> path to set
  [ "$PLACEMENT" = gradient ] || { printf '%s' "$1"; return 0; }
  out="$HOME/.cache/omni/wallpapers/$OMNI_THEME/${1##*/}.png"
  mkdir -p "${out%/*}"
  # re-render when the source, the override, or the renderer itself is newer
  if [ ! -f "$out" ] || [ "$1" -nt "$out" ] || [ "$WP_TOML" -nt "$out" ] || [ "$HOME/.local/bin/omni-wallpaper-render" -nt "$out" ]; then
    omni-wallpaper-render "$1" "$out" --scale "$SCALE" >/dev/null 2>&1 || { printf '%s' "$1"; return 0; }
  fi
  printf '%s' "$out"
}

DIR="$HOME/.config/omni/backgrounds"
THEME_DIR="$HOME/.config/omni/themes/$OMNI_THEME/backgrounds"
STATE="$HOME/.cache/omni/wallpaper"

# The path MUST reach JXA through argv, never string interpolation: a quote in
# a filename would otherwise be executed as JavaScript.
JS='ObjC.import("AppKit");
function run(argv) {
  var url = $.NSURL.fileURLWithPath($(argv[0]));
  var ws = $.NSWorkspace.sharedWorkspace;
  var screens = $.NSScreen.screens;
  var scaling = parseInt(argv[1], 10), clip = argv[2] === "1";
  var r = parseInt(argv[3].substr(1, 2), 16) / 255, g = parseInt(argv[3].substr(3, 2), 16) / 255, b = parseInt(argv[3].substr(5, 2), 16) / 255;
  for (var i = 0; i < screens.count; i++) {
    var scr = screens.objectAtIndex(i);
    var opts = $.NSMutableDictionary.alloc.init;
    opts.setObjectForKey($(scaling), $.NSWorkspaceDesktopImageScalingKey);
    opts.setObjectForKey($(clip), $.NSWorkspaceDesktopImageAllowClippingKey);
    opts.setObjectForKey($.NSColor.colorWithCalibratedRedGreenBlueAlpha(r, g, b, 1.0), $.NSWorkspaceDesktopImageFillColorKey);
    ws.setDesktopImageURLForScreenOptionsError(url, scr, opts, null);
  }
}'

pool() {
  d="$DIR"
  [ -d "$THEME_DIR" ] && d="$THEME_DIR"
  [ -d "$d" ] || return 0
  find "$d" -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
       -o -iname '*.heic' -o -iname '*.webp' \) | sort
}

STORE="$HOME/Library/Application Support/com.apple.wallpaper/Store/Index.plist"

live_spaces() { # how many Spaces carry their own wallpaper override
  /usr/bin/python3 - "$STORE" <<'PY' 2>/dev/null || echo 99
import plistlib, sys
d = plistlib.load(open(sys.argv[1], "rb"))
print(sum("Desktop" in v.get("Default", {}) for v in d.get("Spaces", {}).values()))
PY
}

stage_all_spaces() { # path
  [ -f "$STORE" ] || return 0
  # With a single Space (the AeroSpace way) the plain set reaches everything:
  # skip the store edit and the agent restart, and with them the black frame.
  [ "$(live_spaces)" -le 1 ] && return 0
  cp "$STORE" "$HOME/.cache/omni/Index.plist.bak" 2>/dev/null || true
  /usr/bin/python3 - "$STORE" "$1" "$PLACE_ID" "$FILL" <<'PY' || return 1
import copy, datetime, plistlib, sys, urllib.parse
store, path, place_id, fill = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
d = plistlib.load(open(store, "rb"))
tmpl = d.get("SystemDefault", {}).get("Desktop")
if not tmpl: sys.exit(1)
entry = copy.deepcopy(tmpl)
now = datetime.datetime.now()
entry["LastSet"] = entry["LastUse"] = now
# placement + fill colour, in the agent's own encoding; the colour space blob is
# reused from whatever the agent wrote last (GenericRGB), components are 0..1
rgb = [int(fill[i:i + 2], 16) / 255 for i in (1, 3, 5)] + [1.0]
prev = entry["Content"].get("EncodedOptionValues")
try:
    prev = plistlib.loads(prev) if isinstance(prev, bytes) else {}
    cs = prev["values"]["color"]["color"]["_0"]["color"]["colorSpace"]
except Exception:
    cs = None
values = {"placement": {"picker": {"_0": {"id": place_id}}}}
if cs is not None:
    values["color"] = {"color": {"_0": {"color": {"components": rgb, "colorSpace": cs}}}}
entry["Content"]["EncodedOptionValues"] = plistlib.dumps({"values": values}, fmt=plistlib.FMT_BINARY)
entry["Content"]["Choices"] = [{
    "Provider": "com.apple.wallpaper.choice.image", "Files": [],
    "Configuration": plistlib.dumps({"type": "imageFile", "url": {"relative": "file://" + urllib.parse.quote(path)}}, fmt=plistlib.FMT_BINARY),
}]
d["SystemDefault"]["Desktop"] = copy.deepcopy(entry)
for v in d.get("Displays", {}).values():
    if "Desktop" in v: v["Desktop"] = copy.deepcopy(entry)
for v in d.get("Spaces", {}).values():
    if "Desktop" in v.get("Default", {}): v["Default"]["Desktop"] = copy.deepcopy(entry)
    for dv in v.get("Displays", {}).values():
        if "Desktop" in dv: dv["Desktop"] = copy.deepcopy(entry)
plistlib.dump(d, open(store, "wb"), fmt=plistlib.FMT_BINARY)
PY
  killall WallpaperAgent 2>/dev/null
  i=0; while [ "$i" -lt 30 ] && ! pgrep -x WallpaperAgent >/dev/null 2>&1; do sleep 0.1; i=$((i+1)); done
  sleep 0.6
}

set_wallpaper() {
  [ -f "$1" ] || { echo "no such file: $1" >&2; return 1; }
  src="$1"; set -- "$(render_if_needed "$1")"
  [ "${OMNI_WALLPAPER_ALL_SPACES:-1}" = 1 ] && stage_all_spaces "$1"
  osascript -l JavaScript -e "$JS" "$1" "$SCALING" "$CLIP" "$FILL" || return 1
  mkdir -p "${STATE%/*}"
  printf '%s\n' "$src" > "$STATE"
}

AGENT="$HOME/Library/LaunchAgents/com.omni.wallpaper.plist"
rotate() { # on|off -> (re)install or remove the timer from OMNI_WALLPAPER_ROTATE
  launchctl bootout "gui/$(id -u)" "$AGENT" >/dev/null 2>&1 || true
  if [ "$1" = off ] || [ "${OMNI_WALLPAPER_ROTATE:-0}" -le 0 ] 2>/dev/null; then
    /bin/rm -f "$AGENT"; echo "rotation: off"; return 0
  fi
  mkdir -p "${AGENT%/*}"
  cat > "$AGENT" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.omni.wallpaper</string>
  <key>ProgramArguments</key><array><string>$HOME/.local/bin/omni-wallpaper</string><string>next</string></array>
  <key>StartInterval</key><integer>$OMNI_WALLPAPER_ROTATE</integer>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
</dict></plist>
PLIST
  launchctl bootstrap "gui/$(id -u)" "$AGENT" && echo "rotation: every ${OMNI_WALLPAPER_ROTATE}s"
}

case "${1-}" in
  rotate) rotate "${2-on}" ;;
  set)  set_wallpaper "${2-}" ;;
  list) pool ;;
  current) cat "$STATE" 2>/dev/null ;;
  next|"")
    files=$(pool)
    [ -n "$files" ] || { echo "no wallpapers in $DIR" >&2; exit 1; }
    prev=$(cat "$STATE" 2>/dev/null || true)
    nxt=$(printf '%s\n' "$files" | awk -v p="$prev" '
      { a[NR]=$0; if ($0==p) hit=NR }
      END { print a[(hit % NR) + 1] }')
    set_wallpaper "$nxt" && printf '%s\n' "${nxt##*/}"
    ;;
  *) echo "usage: omni-wallpaper [next|set <path>|list|current|rotate on|off]" >&2; exit 2 ;;
esac
