#!/bin/bash
set -u

. "$HOME/.config/omni/config.sh"
. "$HOME/.local/bin/omni-lib"

INDEX="$HOME/.cache/omni/index.tsv"
TAB=$(printf '\t')
level="${1-}"
q="${2-}"

# A meeting shows at the top of the root menu from OMNI_CALENDAR_LEAD seconds
# before it starts until it ends. Rendered from the provider-agnostic cache
# (start end meet_url hh:mm title) with one awk pass, so any calendar provider
# that writes ~/.cache/omni/calendar.tsv gets it; HEY writes nothing and pays
# nothing. The refresh is fired here too, or the row would only ever be as
# fresh as the last visit to Utilities > Calendar.
emit_now() {
  [ "${OMNI_CALENDAR_VIEW:-app}" = list ] || return 0
  [ "${SEARCHING:-0}" = 1 ] && return 0
  tsv="$HOME/.cache/omni/calendar.tsv"; st="$HOME/.cache/omni/calendar.status"
  now=$(date +%s)
  age=$(( now - $(stat -f %m "$st" 2>/dev/null || echo 0) ))
  if [ "$age" -gt "${OMNI_CALENDAR_TTL:-300}" ]; then
    ( omni-calendar refresh ) >/dev/null 2>&1 </dev/null &
  fi
  [ -f "$tsv" ] || return 0
  awk -F'\t' -v now="$now" -v lead="${OMNI_CALENDAR_LEAD:-300}" \
      -v hold="${OMNI_CALENDAR_HOLD:-1200}" -v g="󰃰" '
    # A row lives from lead before the start until hold after it, or until the
    # event ends, whichever comes first. Without the hold a nine-hour focus
    # block owns the row all day and crowds out the meetings.
    NF >= 5 && $1 - lead <= now && now < ($1 + hold < $2 ? $1 + hold : $2) && ++n <= 2 {
      if ($3 != "") printf "url\t%s  %s %s\t%s\n", g, $4, $5, $3
      else          printf "run\t%s  %s %s\tcalendar-open\n", g, $4, $5
      shown = 1 }
    END { if (shown) printf "sep\t\t\n" }' "$tsv"
}

SECTIONS="$HOME/.config/omni/sections"
if [ -s "$SECTIONS" ]; then
  ids=$(grep -vE '^[[:space:]]*(#|$)' "$SECTIONS" | tr -d ' ' | tr '\n' ' ')
else
  ids="apps style setup capture utilities passwords update system"
fi

rows() {
lvl="${1-$level}"
case "$lvl" in
  "")
    emit_now
    # Root entries are listed in ~/.config/omni/sections, one id per line.
    # Comment a line out to hide that section; reorder lines to reorder the menu.
    for id in $ids; do
      case "$id" in
        apps)    printf 'search\t%s  Apps\t\n'      "" ;;
        style)   printf 'menu\t%s  Style\tstyle\n'  "" ;;
        setup)   printf 'menu\t%s  Setup\tsetup\n'  "" ;;
        capture) printf 'menu\t%s  Capture\tcapture\n' "" ;;
        update)  printf 'menu\t%s  Update\tupdate\n' "" ;;
        utilities) printf 'menu\t%s  Utilities\tutilities\n' "" ;;
        passwords) printf 'menu\t%s  Passwords\tpasswords\n' "" ;;
        system)  printf 'menu\t%s  System\tsystem\n' "" ;;
        work)    printf 'menu\t%s  Work\twork\n' "$(printf '\xef\x82\xb1')" ;;
      esac
    done
    ;;
  style)
    printf 'menu\t%s  Theme\ttheme\n' "$(printf '\xef\x87\x9e')"
    printf 'menu\t%s  Font\tfont\n'  "$(printf '\xef\x80\xb1')"
    printf 'menu\t%s  Shader\tshader\n' "$(printf '\xef\x83\x90')"
    printf 'menu\t%s  Look\tlook\n'   "$(printf '\xef\x87\xbc')"
    printf 'act\t󰸉  Next wallpaper\twallpaper-next\n'
    ;;
  font)
    # Ghostty has no escape sequence for changing font, so unlike themes this
    # cannot preview live - Enter writes the config and restarts the instance.
    FONTS="$HOME/.cache/omni/fonts.txt"
    if [ ! -s "$FONTS" ] || [ -n "$(find "$FONTS" -mtime +7 2>/dev/null)" ]; then
      /Applications/Ghostty.app/Contents/MacOS/ghostty +list-fonts 2>/dev/null |
        grep -E '^[A-Za-z]' | grep -iE 'mono|nerd|code|consol|menlo|courier' |
        sort -u > "$FONTS"
    fi
    while IFS= read -r fam; do
      [ -n "$fam" ] || continue
      if [ "$fam" = "$OMNI_FONT" ]; then
        printf 'font\t%s  %s\t%s\n' "$(printf '\xef\x80\x8c')" "$fam" "$fam"
      else
        printf 'font\t   %s\t%s\n' "$fam" "$fam"
      fi
    done < "$FONTS"
    ;;
  look)
    # A look is colours plus type, density, frame and shader. Like Font and
    # Shader it cannot preview live, so Enter writes config.sh and restarts.
    cur=$(omni-look current)
    omni-look list | while IFS= read -r n; do
      [ -n "$n" ] || continue
      if [ "$n" = "$cur" ]; then
        printf 'look\t%s  %s\t%s\n' "$(printf '\xef\x80\x8c')" "$n" "$n"
      else
        printf 'look\t   %s\t%s\n' "$n" "$n"
      fi
    done
    ;;
  shader)
    # Ghostty cannot reload a shader live (GOTCHAS 17), so Enter writes the
    # config and restarts the instance, exactly like Font.
    cur="${OMNI_SHADER:-}"
    printf '%s\n' \
      "None	" \
      "Lava	cineShader-Lava.glsl" \
      "Bloom	bloom.glsl" \
      "Dither	dither.glsl" \
      "Glow RGB Split	glow-rgbsplit-twitchy.glsl" \
      "Mnoise	mnoise.glsl" \
      "Retro Terminal	retro-terminal.glsl" \
      "Halftone	np-halftone-dark.glsl" \
      "Vellum	np-vellum-dark.glsl" \
      "Tessera	np-tessera.glsl" |
    while IFS="	" read -r label file; do
      if [ "$file" = "$cur" ]; then
        printf 'shader\t%s  %s\t%s\n' "$(printf '\xef\x80\x8c')" "$label" "$file"
      else
        printf 'shader\t   %s\t%s\n' "$label" "$file"
      fi
    done
    ;;
  theme)
    current=$(sed -n 's/^OMNI_THEME="\(.*\)"/\1/p' "$HOME/.config/omni/config.sh")
    for f in "$HOME"/.config/omni/themes/*/colors.toml; do
      name="${f%/colors.toml}"; name="${name##*/}"
      if [ "$name" = "$current" ]; then
        printf 'theme\t  %s\t%s\n' "$name" "$name"
      else
        printf 'theme\t   %s\t%s\n' "$name" "$name"
      fi
    done
    ;;
  setup)
    printf 'run\t  System Settings\tsettings\n'
    printf 'run\t  Wifi\twifi\n'
    printf 'run\t  Bluetooth\tbluetooth\n'
    printf 'run\t  Audio\taudio\n'
    printf 'run\t  Displays\tdisplays\n'
    printf 'run\t  Config\tconfig\n'
    ;;
  update)
    printf 'run\t  Homebrew\tbrew\n'
    printf 'run\t  macOS\tmacos\n'
    ;;
  utilities)
    printf 'menu\t  Weather\tweather\n'
    printf 'menu\t  CPU\tcpu\n'
    printf 'menu\t  Memory\tmemory\n'
    printf 'menu\t  Network\tnetwork\n'
    if [ "${OMNI_CALENDAR_VIEW:-app}" = list ]; then
      printf 'menu\t󰸗  Calendar\tcalendar\n'
    else
      printf 'run\t󰸗  Calendar\tcalendar\n'
    fi
    printf 'run\t󰇮  Mail\tmail\n'
    printf 'run\t  System Monitor\tmonitor\n'
    if [ -s "$HOME/.cache/omni/caffeinate.pid" ] && kill -0 "$(cat "$HOME/.cache/omni/caffeinate.pid")" 2>/dev/null; then
      printf 'act\t  Caffeinate  \tcaffeinate\n'
    else
      printf 'act\t  Caffeinate\tcaffeinate\n'
    fi
    ;;
  weather)
    omni-weather
    ;;
  passwords)
    omni-pass-rows
    ;;
  cpu|mem*|net*)
    case "$lvl" in cpu) k=cpu ;; mem*) k=mem ;; *) k=net ;; esac
    omni-sysinfo "$k"
    printf 'run\t  Open in btop\tbtop-%s\n' "$k"
    printf 'act\t  Refresh\t%s-refresh\n' "$k"
    printf 'back\t  Back\t\n'
    ;;
  capture)
    printf 'run\t  Screenshot\tscreenshot\n'
    printf 'run\t  Screen Recording\tscreenrecord\n'
    printf 'run\t  Color Picker\tcolorpicker\n'
    ;;
  system)
    printf 'run\t  Lock\tlock\n'
    printf 'run\t  Screensaver\tsaver\n'
    printf 'run\t  Sleep\tsleep\n'
    printf 'menu\t  Logout\tconfirm:logout\n'
    printf 'menu\t  Restart\tconfirm:restart\n'
    printf 'menu\t  Shutdown\tconfirm:shutdown\n'
    ;;
  work)
    printf 'menu\t%s  Jira\tjira\n'     "$(printf '\xee\x9d\x9c')"
    printf 'menu\t%s  GitLab\tgitlab\n' "$(printf '\xee\x9f\xab')"
    ;;
  calendar) omni-calendar rows ;;
  jira)   omni-jira rows ;;
  gitlab) omni-gitlab rows ;;
  confirm:*)
    what="${level#confirm:}"
    printf 'run\t  Yes, %s\t%s\n' "$what" "$what"
    printf 'back\t  Cancel\t\n'
    ;;
esac
}

if [ -z "$q" ]; then
  rows | mark_favs
  exit 0
fi

# The menu prompt doubles as a calculator and a web search, so a query can
# produce rows that are not in the menu tree at all. That is why omni runs the
# menu with --disabled and filters here instead of letting fzf do it.
case "$q" in
  '='*) emit_calc "${q#=}"; exit 0 ;;
  '@'*) emit_web  "${q#@}"; exit 0 ;;
esac

emit_ticket "$q"
looks_like_math "$q" && emit_calc "$q"

if [ -z "$level" ]; then
  # The meeting row is not part of the searchable tree.
  SEARCHING=1
  # Flatten only the sections that are actually enabled, so hiding one in
  # ~/.config/omni/sections also removes it from search. `font` is left out on
  # purpose: half the family names contain "Mono"/"Nerd" and match everything.
  rows ""
  for id in $ids; do
    case "$id" in
      # look before theme: they share names by design, the dedupe keeps the
      # first, and a look applies everything where its theme is colours only.
      style)   rows style; rows look; rows theme; rows shader ;;
      setup)   rows setup ;;
      capture) rows capture ;;
      update)  rows update ;;
      utilities) rows utilities ;;
      system)  rows system ;;
      work)    rows work ;;
    esac
  done
else
  rows "$level"
fi | { if [ -z "$level" ]; then grep -v "^sep$TAB"; else cat; fi; } |
  { if [ -z "$level" ]; then awk -F'\t' -v OFS='\t' '!seen[$2]++'; else cat; fi; } |
  fzf --ansi -i --filter="$q" --delimiter="$TAB" --nth=2 2>/dev/null | mark_favs rank

emit_web "$q"
