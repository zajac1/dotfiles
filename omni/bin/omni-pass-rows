#!/bin/bash
#
# Menu rows for the Passwords section.
#
# WHY THERE IS A CACHE AT ALL: `pass-cli` measures 3378 ms to list and 781 ms
# for status. That is unusable per menu render, never mind per keystroke, so the
# item list is cached and refreshed in the background - the weather pattern.
#
# WHAT IS CACHED: ids and titles ONLY. Never a secret. The file is still
# sensitive (it reveals which services you hold accounts with), so it is 0600.
set -u
. "$HOME/.config/omni/config.sh" 2>/dev/null || true

CACHE="$HOME/.cache/omni/pass.tsv"
STAT="$HOME/.cache/omni/pass.status"
TTL="${OMNI_PASS_CACHE_TTL:-900}"

# fzf kills the previous `change:reload` on every keystroke. If the refresh runs
# in that path, each keypress starts a 3.4s pass-cli call and kills the last one
# mid-flight, so you get partial results that "arrive later". Refreshes are now
# always detached and serialised behind a lock; the render path only ever reads
# whatever is already cached.
LOCK="$HOME/.cache/omni/pass.lock"

# `( refresh & )` only detaches from the parent, not from the process group,
# and the group is what gets killed when the row list is rebuilt - which left a
# 0-byte status file and a lock nobody would release. A new session survives.
spawn_refresh() {
  python3 -c 'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' \
    "$HOME/.local/bin/omni-pass-rows" --refresh >/dev/null 2>&1 &
}

refresh() {
  # A trap EXIT inside a backgrounded subshell did not fire reliably, leaving a
  # stale lock that would block every future refresh. Release explicitly, and
  # reap a lock older than 120s in case a refresh is killed outright.
  if [ -d "$LOCK" ]; then
    age=$(( $(date +%s) - $(stat -f %m "$LOCK" 2>/dev/null || echo 0) ))
    [ "$age" -gt 120 ] && rmdir "$LOCK" 2>/dev/null
  fi
  mkdir "$LOCK" 2>/dev/null || return 0
  omni-pass status > "$STAT.new" 2>/dev/null
  mv "$STAT.new" "$STAT" 2>/dev/null
  if [ "$(cat "$STAT" 2>/dev/null)" = unlocked ]; then
    umask 077
    omni-pass list | omni-brandify > "$CACHE.new" 2>/dev/null
    [ -s "$CACHE.new" ] && mv "$CACHE.new" "$CACHE" || rm -f "$CACHE.new"
  fi
  rmdir "$LOCK" 2>/dev/null
}

[ "${1-}" = --refresh ] && { refresh; exit 0; }

if [ ! -s "$STAT" ]; then
  spawn_refresh
  printf 'sep\t  Loading vault… reopen soon\t\n'
  printf 'back\t  Back\t\n'
  exit 0
else
  age=$(( $(date +%s) - $(stat -f %m "$STAT") ))
  [ "$age" -gt "$TTL" ] && spawn_refresh
fi

case "$(cat "$STAT" 2>/dev/null)" in
  unavailable) printf 'sep\t  %s CLI not installed\t\n' "${OMNI_PASS_PROVIDER:-protonpass}"
               printf 'back\t  Back\t\n'; exit 0 ;;
  logged-out)  printf 'sep\t  Not logged in\t\n'
               printf 'run\t  Log in\tpass-login\n'
               printf 'back\t  Back\t\n'; exit 0 ;;
  locked)      printf 'sep\t  Vault locked\t\n'
               printf 'run\t  Unlock\tpass-unlock\n'
               printf 'back\t  Back\t\n'; exit 0 ;;
esac

if [ -s "$CACHE" ]; then
  awk -F'\t' '{ printf "pass\t%s  %s\t%s\n", ($3 == "" ? "" : $3), $2, $1 }' "$CACHE"
else
  printf 'sep\t  No items cached yet\t\n'
fi
printf 'act\t  Refresh\tpass-refresh\n'
