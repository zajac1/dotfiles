#!/bin/bash
set -u

. "$HOME/.config/omni/config.sh"
PENDING="$HOME/.cache/omni/pending"
USES="$HOME/.cache/omni/uses"

line=$(cat "$PENDING" 2>/dev/null)
: > "$PENDING"
[ -n "$line" ] || exit 0

kind=$(printf '%s' "$line" | cut -f1)
payload=$(printf '%s' "$line" | cut -f3)

# Windows opened for one task must quit with that window. On macOS
# quit-after-last-window-closed defaults to false, so without this every btop,
# every brew upgrade, every editor leaves a windowless Ghostty behind - which
# is how six of them end up in cmd-tab.
# Same app bundle as the user's Ghostty, so without the second flag macOS
# restores their saved windows into the one-shot window as extra tabs.
GHOSTTY_ONESHOT="--quit-after-last-window-closed=true --window-save-state=never"

edit() { open -na Ghostty.app --args $GHOSTTY_ONESHOT -e nvim "$1"; }
settings() { open "x-apple.systempreferences:$1"; }

# One count per app path, so the empty Apps list can lead with what you actually
# open. Counts only, never a timestamp: a bounded file that never needs pruning.
count_use() {
  ( umask 077; touch "$USES"
    awk -F'\t' -v OFS='\t' -v p="$1" '
      $1 == p { $2++; seen = 1 } { print } END { if (!seen) print p, 1 }
    ' "$USES" > "$USES.new" && mv "$USES.new" "$USES" )
}

case "$kind" in
  app)     open -a "$payload"; count_use "$payload" ;;
  project) open -na Ghostty.app --args $GHOSTTY_ONESHOT --working-directory="$payload" ;;
  file)    open -R "$payload" ;;
  calc)    printf '%s' "$payload" | pbcopy ;;
  web)     open "${OMNI_SEARCH_URL}$(printf '%s' "$payload" | jq -sRr @uri)" ;;
  url)
    # Only https links whose authority IS a configured host: userinfo tricks
    # (host@evil) and lookalikes (host.evil) fail the equality, not a prefix test.
    case "$payload" in https://*) ;; *) exit 0 ;; esac
    host="${payload#https://}"; host="${host%%/*}"
    case "$host" in
      "") ;;
      "${OMNI_JIRA_HOST:-}"|"${OMNI_GITLAB_HOST:-}") open "$payload" ;;
      *) for h in ${OMNI_URL_HOSTS:-}; do [ "$host" = "$h" ] && { open "$payload"; break; }; done ;;
    esac ;;
  pass)    omni-pass-copy "$payload" ;;
  run|act)
    case "$payload" in
      brew)        open -na Ghostty.app --args $GHOSTTY_ONESHOT -e bash -lc 'brew update && brew upgrade; echo; read -rp "Press enter to close "' ;;
      # softwareupdate -ia needs sudo; a password prompt out of a launcher is
      # bad UX, so open the pane instead - one click and no elevation here.
      # The vault status is cached for OMNI_PASS_CACHE_TTL; drop it once the
      # command finishes so the next render re-probes instead of still saying locked.
      pass-login)   open -na Ghostty.app --args $GHOSTTY_ONESHOT -e bash -c "'$HOME/.local/bin/omni-pass' login; rm -f '$HOME/.cache/omni/pass.status'" ;;
      pass-unlock)  open -na Ghostty.app --args $GHOSTTY_ONESHOT -e bash -c "'$HOME/.local/bin/omni-pass' unlock; rm -f '$HOME/.cache/omni/pass.status'" ;;
      pass-refresh) rm -f "$HOME/.cache/omni/pass.status"; omni-pass-rows >/dev/null 2>&1 ;;
      jira-view)     omni-jira toggle ;;
      jira-refresh)  rm -f "$HOME/.cache/omni/jira.tsv"; ( omni-jira refresh >/dev/null 2>&1 & ) ;;
      gitlab-refresh) rm -f "$HOME/.cache/omni/gitlab.tsv"; ( omni-gitlab refresh >/dev/null 2>&1 & ) ;;
      btop-cpu)    open -na Ghostty.app --args $GHOSTTY_ONESHOT -e "$HOME/.local/bin/omni-btop" cpu ;;
      btop-mem)    open -na Ghostty.app --args $GHOSTTY_ONESHOT -e "$HOME/.local/bin/omni-btop" mem ;;
      btop-net)    open -na Ghostty.app --args $GHOSTTY_ONESHOT -e "$HOME/.local/bin/omni-btop" net ;;
      cpu-refresh|mem-refresh|net-refresh) : ;;
      caffeinate)  omni-caffeinate toggle ;;
      wallpaper-next) omni-wallpaper next ;;
      monitor)     open -na Ghostty.app --args $GHOSTTY_ONESHOT -e "$HOME/.local/bin/omni-btop" "cpu mem net proc" ;;
      calendar)    omni-calendar ;;
      mail)        omni-mail ;;
      weather-report) open -na Ghostty.app --args $GHOSTTY_ONESHOT -e "$HOME/.local/bin/omni-weather-report" ;;
      weather-refresh) rm -f "$HOME/.cache/omni/weather.json"; omni-weather >/dev/null 2>&1 ;;
      macos)       settings "com.apple.Software-Update-Settings.extension" ;;
      config)      edit "$HOME/.config/omni/config.sh" ;;
      settings)    open -a "System Settings" ;;
      wifi)        settings "com.apple.wifi-settings-extension" ;;
      bluetooth)   settings "com.apple.BluetoothSettings" ;;
      audio)       settings "com.apple.Sound-Settings.extension" ;;
      displays)    settings "com.apple.Displays-Settings.extension" ;;
      screenshot)  screencapture -i -c ;;
      colorpicker) open -a "Digital Color Meter" ;;
      lock)        pmset displaysleepnow ;;
      saver)       open -a ScreenSaverEngine ;;
      sleep)       osascript -e 'tell application "System Events" to sleep' ;;
      logout)      osascript -e 'tell application "System Events" to log out' ;;
      restart)     osascript -e 'tell application "System Events" to restart' ;;
      shutdown)    osascript -e 'tell application "System Events" to shut down' ;;
    esac ;;
esac
