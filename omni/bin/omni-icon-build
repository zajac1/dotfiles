#!/bin/bash
#
# omni-icon-build - the app icon, and the notifier that wears it.
#
# Renders assets/icon.svg to ~/.local/share/omni/icon.png (Ghostty's
# macos-custom-icon takes a PNG) and builds ~/.local/share/omni/omni.app, a
# one-line AppleScript applet whose only job is `display notification`.
# Notifications carry the icon of the app that posts them; osascript's is
# Script Editor's, this applet's is ours. Everything used here ships with macOS.
#
# TRAPS: osacompile bundles its default icon as an asset catalog and points
# CFBundleIconName at it, which wins over the .icns - both must go. macOS also
# relaunches applets with no arguments now and then; without the count check
# `item 2 of argv` throws an error dialog.
set -eu

OUT="$HOME/.local/share/omni"
APP="$OUT/omni.app"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

# The installer passes the repo's assets/icon.svg; it is kept next to the
# output so a later rebuild needs no argument.
mkdir -p "$OUT"
if [ -n "${1-}" ]; then cp "$1" "$OUT/icon.svg"; fi
SVG="$OUT/icon.svg"
[ -f "$SVG" ] || { echo "omni-icon-build: no icon.svg - pass a path" >&2; exit 1; }
# sips renders SVG directly; qlmanage does too but hangs now and then on a
# busy QuickLook daemon.
sips -s format png -Z 1024 "$SVG" --out "$OUT/icon.png" >/dev/null

mkdir "$WORK/icon.iconset"
for s in 16 32 128 256 512; do
  sips -z "$s" "$s" "$OUT/icon.png" --out "$WORK/icon.iconset/icon_${s}x${s}.png" >/dev/null
  sips -z "$((s*2))" "$((s*2))" "$OUT/icon.png" --out "$WORK/icon.iconset/icon_${s}x${s}@2x.png" >/dev/null
done
iconutil -c icns "$WORK/icon.iconset" -o "$WORK/icon.icns"

rm -rf "$APP"
osacompile -o "$APP" -e 'on run argv
  if (count of argv) < 2 then return
  display notification (item 2 of argv) with title (item 1 of argv)
end run' 2>/dev/null
rm -f "$APP/Contents/Resources/Assets.car"
cp "$WORK/icon.icns" "$APP/Contents/Resources/applet.icns"
plutil -remove CFBundleIconName "$APP/Contents/Info.plist" >/dev/null 2>&1 || true
plutil -replace CFBundleIdentifier -string com.omni.notifier "$APP/Contents/Info.plist"
plutil -replace CFBundleName -string omni "$APP/Contents/Info.plist"
codesign --force --deep --sign - "$APP" 2>/dev/null
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$APP"
echo "icon: $OUT/icon.png, notifier: $APP"
