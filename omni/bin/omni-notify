#!/bin/bash
# omni-notify <title> <message> - a notification with omni's icon, when the
# notifier app from omni-icon-build exists; plain osascript otherwise.
set -u
APP="$HOME/.local/share/omni/omni.app"
title="${1:-omni}"; msg="${2-}"
if [ -d "$APP" ]; then
  open -a "$APP" --args "$title" "$msg"
else
  osascript -e "display notification \"${msg//\"/\\\"}\" with title \"${title//\"/\\\"}\"" 2>/dev/null
fi
