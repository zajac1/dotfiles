#!/bin/bash
set -u
CACHE="$HOME/.cache/omni"
STACK="$CACHE/stack"
PENDING="$CACHE/pending"
line="${1-}"
[ -n "$line" ] || { echo "ignore"; exit 0; }

kind=$(printf '%s' "$line" | cut -f1)
payload=$(printf '%s' "$line" | cut -f3)

# Ghostty picks a config change up live (omni-reload); the preview already
# showed it, so this is the commit. The restart is the fallback for a machine
# where the AppleScript route is refused.
apply_config() {
  if omni-reload >/dev/null 2>&1; then
    sed -i '' -e '$d' "$STACK" 2>/dev/null
    echo 'become(omni --menu)'
  else
    omni-restart
    echo 'abort'
  fi
}

case "$kind" in
  sep)    echo 'ignore' ;;
  theme)
    # Everything omni-theme does except the launcher restart - this IS the
    # launcher, and it re-enters the menu itself via become(). The wallpaper
    # step restarts WallpaperAgent and takes ~2s, so it runs detached.
    omni-theme --no-restart "$payload" >/dev/null 2>&1
    sed -i '' -e '$d' "$STACK" 2>/dev/null
    echo 'become(omni --menu)' ;;
  font)
    sed -i '' "s|^OMNI_FONT=\".*\"|OMNI_FONT=\"$payload\"|" "$HOME/.config/omni/config.sh"
    apply_config ;;
  look)
    # omni-look restarts the launcher itself when the look changes the window
    # size, which Ghostty reads only at start; the menu is gone by then.
    case "$(omni-look "$payload" 2>/dev/null)" in
      restart) echo 'abort' ;;
      *) sed -i '' -e '$d' "$STACK" 2>/dev/null; echo 'become(omni --menu)' ;;
    esac ;;
  shader)
    sed -i '' "s|^OMNI_SHADER=\".*\"|OMNI_SHADER=\"$payload\"|" "$HOME/.config/omni/config.sh"
    apply_config ;;
  act)
    printf '%s' "$line" > "$PENDING"
    case "$payload" in
      *-refresh)
        # Not here: transform blocks fzf, so a network round-trip in it freezes
        # the launcher, and become() re-renders from whatever the cache held a
        # moment ago. reload-sync runs the fetch with the UI live, keeps the old
        # rows and the query on screen, and swaps the list when the new rows
        # land. The box keeps its height until the next level change.
        level=$(tail -1 "$STACK" 2>/dev/null)
        echo "reload-sync(omni-exec >/dev/null 2>&1; omni-menu-query '${level:-}' {q})" ;;
      *)
        omni-exec >/dev/null 2>&1
        echo 'become(omni --menu)' ;;
    esac ;;
  menu)   printf '%s\n' "$payload" >> "$STACK"; echo 'become(omni --menu)' ;;
  search) echo 'become(omni --search)' ;;
  back)   sed -i '' -e '$d' "$STACK" 2>/dev/null; echo 'become(omni --menu)' ;;
  *)      printf '%s' "$line" > "$PENDING"; echo 'become(omni-exec)' ;;
esac
