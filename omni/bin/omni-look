#!/bin/bash
#
# omni-look - apply a complete look: colours, type, density, frame, shader.
#
# A theme is colours only. A look is everything, including which theme to use.
# looks/<name>.sh holds OMNI_* lines; every key it names is copied into
# config.sh and every key it omits is left alone. The look file is PARSED, not
# sourced, so a look can never execute anything.
set -u

PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"; export PATH

CONF="$HOME/.config/omni/config.sh"
DIR="$HOME/.config/omni/looks"

case "${1-}" in
  current)
    # Derived, not stored. A stored name goes stale the moment Font or Shader
    # writes one of the values a look owns.
    for f in "$DIR"/*.sh; do
      [ -f "$f" ] || continue
      match=1
      while IFS= read -r line; do
        case "$line" in OMNI_*=*) ;; *) continue ;; esac
        grep -qxF "$line" "$CONF" || { match=0; break; }
      done < "$f"
      [ "$match" = 1 ] && { basename "$f" .sh; exit 0; }
    done
    ;;
  list)
    for f in "$DIR"/*.sh; do
      [ -f "$f" ] || continue
      n=$(basename "$f" .sh)
      printf '%s\n' "$n"
    done
    ;;
  --preview)
    # Show a look in the running launcher without writing config.sh: colours
    # as OSC, the rest through the Ghostty config. Parsed, not sourced, like
    # the apply path; values are shell literals, so the quotes come off. The
    # fzf geometry (columns, padding, borders) only follows on Enter.
    name="${2-}"
    case "$name" in ''|*[!a-z0-9-]*) exit 1 ;; esac
    f="$DIR/$name.sh"
    [ -f "$f" ] || exit 1
    theme=""
    set --
    while IFS= read -r line; do
      case "$line" in OMNI_[A-Z_]*=*) ;; *) continue ;; esac
      key="${line%%=*}"; value="${line#*=}"; value="${value#\"}"; value="${value%\"}"
      [ "$key" = OMNI_THEME ] && theme="$value"
      set -- "$@" "$key=$value"
    done < "$f"
    [ -n "$theme" ] && omni-osc "$theme"
    omni-reload "$@"
    ;;
  ''|-*)
    echo "usage: omni-look list | omni-look current | omni-look --preview <name> | omni-look <name>" >&2; exit 1 ;;
  *)
    name="$1"
    case "$name" in *[!a-z0-9-]*) exit 1 ;; esac
    f="$DIR/$name.sh"
    [ -f "$f" ] || { omni-notify omni "No such look: $name" 2>/dev/null; exit 1; }

    # awk, not sed: a value can hold %, comma or slash, and awk needs no
    # escaping. Only keys the look names are touched.
    size_before=$(sed -n 's/^OMNI_TERM_SIZE=//p' "$CONF")
    tmp="$CONF.new"
    awk -v lf="$f" '
      BEGIN {
        while ((getline line < lf) > 0)
          if (line ~ /^OMNI_[A-Z_]+=/) {
            eq = index(line, "="); v[substr(line, 1, eq-1)] = substr(line, eq+1)
          }
      }
      {
        if ($0 ~ /^OMNI_[A-Z_]+=/) {
          eq = index($0, "="); k = substr($0, 1, eq-1)
          if (k in v) { print k "=" v[k]; next }
        }
        print
      }
    ' "$CONF" > "$tmp" || { rm -f "$tmp"; exit 1; }
    mv "$tmp" "$CONF"


    # omni-theme owns everything a theme switch touches: the compiled cache,
    # the terminal palette file the launcher loads, the editor, the bar and the
    # system appearance. Writing OMNI_THEME alone leaves the launcher on the
    # previous palette.
    theme=$(sed -n 's/^OMNI_THEME="\(.*\)"/\1/p' "$CONF")
    omni-theme --no-restart "$theme" >/dev/null 2>&1

    # Everything in a look reloads live except the window size, which Ghostty
    # reads only at start (verified: quick-terminal-size ignores reload_config,
    # even across a hide and show). That one still restarts, and says so.
    size_after=$(sed -n 's/^OMNI_TERM_SIZE=//p' "$CONF")
    if [ "$size_before" = "$size_after" ] && omni-reload >/dev/null 2>&1; then
      exit 0
    fi
    omni-restart
    echo restart
    ;;
esac
